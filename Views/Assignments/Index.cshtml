@model IEnumerable<Assignment>
@{
    ViewData["Title"] = "Assignments";
}

<div class="d-flex justify-content-between mb-3">
    <h1>Assignments</h1>
    <a class="btn btn-primary" asp-action="Create">+ Add Assignment</a>
</div>

<form asp-action="Index" method="get" class="card card-body mb-3">
    <div class="row g-2">
        <div class="col-md-6">
            <input name="searchString" value="@ViewBag.SearchString"
                   class="form-control" placeholder="Search title or subject" />
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">All statuses</option>
                <option value="Pending" selected="@(ViewBag.Status as string == "Pending")">Pending</option>
                <option value="In Progress" selected="@(ViewBag.Status as string == "In Progress")">In Progress</option>
                <option value="Completed" selected="@(ViewBag.Status as string == "Completed")">Completed</option>
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-outline-primary" type="submit">Search</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Subject</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="5">No assignments found.</td></tr>
            }
            else
            {
                @foreach (var a in Model)
                {
                    <tr>
                        <td>
                            <strong>@a.Title</strong>
                            <div class="text-muted small">@a.Description</div>
                        </td>
                        <td>@a.Subject?.Name</td>
                        <td class="@(a.Status != "Completed" && a.DueDate.Date < DateTime.Today ? "text-danger fw-bold" : "")">
                            @a.DueDate.ToString("dd MMM yyyy")
                        </td>
                        <td>@a.Status</td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-action="Edit" asp-route-id="@a.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger"
                               asp-action="Delete" asp-route-id="@a.Id">Delete</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>