@model IEnumerable<Subject>
@{
    ViewData["Title"] = "Subjects";
}

<div class="d-flex justify-content-between mb-3">
    <h1>Subjects</h1>
    <a class="btn btn-primary" asp-action="Create">+ Add Subject</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Description</th>
                    <th>Assignments</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="5">No subjects found.</td></tr>
            }
            else
            {
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Name</td>
                        <td>@s.SubjectCode</td>
                        <td>@s.Description</td>
                        <td>@s.Assignments.Count</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary"
                               asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger"
                               asp-action="Delete" asp-route-id="@s.Id">Delete</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>