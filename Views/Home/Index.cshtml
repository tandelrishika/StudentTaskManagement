@model IEnumerable<Assignment>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Dashboard</h1>
        <p class="text-muted">Track your subjects and assignments.</p>
    </div>
    <a class="btn btn-primary"
       asp-controller="Assignments" asp-action="Create">
        + Add Assignment
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4 col-lg-2">
        <div class="stat-card">
            <span>Subjects</span><strong>@ViewBag.SubjectCount</strong>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="stat-card">
            <span>Assignments</span><strong>@ViewBag.AssignmentCount</strong>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="stat-card">
            <span>Pending</span><strong>@ViewBag.PendingCount</strong>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="stat-card">
            <span>In Progress</span><strong>@ViewBag.InProgressCount</strong>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="stat-card">
            <span>Completed</span><strong>@ViewBag.CompletedCount</strong>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="stat-card">
            <span>Overdue</span><strong>@ViewBag.OverdueCount</strong>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between">
        <strong>Upcoming Assignments</strong>
        <a asp-controller="Assignments" asp-action="Index">View all</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Assignment</th>
                    <th>Subject</th>
                    <th>Due Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center py-4">
                        No assignments yet.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Subject?.Name</td>
                        <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                        <td>@item.Status</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
